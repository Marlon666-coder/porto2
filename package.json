{
  "name": "marlo-universe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MARLO — EXPLORE MY UNIVERSE. An immersive cinematic 3D space portfolio built with React, TypeScript, Vite and Three.js.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:nocheck": "vite build",
    "preview": "vite preview",
    "preview:pages": "vite preview --base /marlo-universe/"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.166.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
